{
  "app": {
    "windows": [
      {
        "title": "Local PDF Organizer",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": ["pdfium/pdfium.dll"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
